# --- Server ---
# Port the Express server binds on. Sibling ton-bot uses 3030, so TonExplorer defaults to 3031.
PORT=3031

# Public base path the app is served under. Used by the frontend and by Express
# to mount routes when behind a reverse proxy (nginx) that strips/passes the prefix.
BASE_PATH=/explorer

# Public origin of the deployed app (used when generating absolute URLs in API responses).
# Use your own domain. Example: https://your-server.example.com
PUBLIC_ORIGIN=https://your-server.example.com

# Comma-separated list of trusted proxy IPs/CIDRs (for Express `trust proxy`).
# Leave as "loopback" if nginx runs on the same host.
TRUST_PROXY=loopback

# --- Data sources ---
# TonAPI key — sign up at https://tonconsole.com/. Optional, but raises rate limits.
TONAPI_KEY=
# Network: mainnet | testnet
TON_NETWORK=mainnet

# Optional TonCenter API key (used as secondary source / fallback).
TONCENTER_KEY=

# --- DB ---
# SQLite file path, relative to project root. data/ is gitignored.
SQLITE_PATH=data/explorer.sqlite

# --- Rate limit (public read-only API) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Telegram bot (phase 2, not used yet) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
